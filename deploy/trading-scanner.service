[Unit]
Description=Blackbox AI Sentiment Scanner
After=network.target
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/blackbox-ki
ExecStart=/home/ubuntu/blackbox-ki/.venv/bin/python /home/ubuntu/blackbox-ki/run_scanner.py
Restart=always
RestartSec=30
[Install]
WantedBy=multi-user.target
